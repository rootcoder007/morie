    def wavelet_time_series(x, wavelet="haar", level=None):
        r"""Multiresolution decomposition via the discrete wavelet transform.
    
        .. math::
    
            x(t) = \sum_j \sum_k c_{j,k}\,\psi_{j,k}(t)
    
