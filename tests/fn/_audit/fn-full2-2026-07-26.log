    def tgarch_model(x):
        r"""Fit a Glosten-Jagannathan-Runkle GARCH(1,1) model.
    
        .. math::
    
            \sigma_t^2 = \omega + (\alpha + \gamma I_{t-1})\,\epsilon_{t-1}^2
                         + \beta\,\sigma_{t-1}^2,
            \quad I_{t-1} = 1\{\epsilon_{t-1} < 0\}.
    
        Parameters
        ----------
        x : array-like
            Return series.
    
        Returns
        -------
