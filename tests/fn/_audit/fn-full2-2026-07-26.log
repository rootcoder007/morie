        if cdf is None:
            cdf_vals = stats.norm.cdf(x_sorted, loc=np.mean(X), scale=np.std(X, ddof=1))
        else:
            cdf_vals = np.array([cdf(xi) for xi in x_sorted])
        ecdf = np.arange(1, n + 1) / n
