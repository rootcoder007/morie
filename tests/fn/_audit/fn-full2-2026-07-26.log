    def jacquez_k_nn_test(coords, time, k, cdf=None):
        """
        Jacquez k-nearest-neighbour space-time test
    
        Formula: J_k = sum_i sum_{j in NN_k(i)} a_ij b_ij
    
        Parameters
        ----------
        coords : array-like
            Input data.
        time : array-like
            Input data.
        k : array-like
            Input data.
        cdf : array-like
            Input data.
    
        Returns
        -------
        result : dict
            Keys: estimate
    
        References
        ----------
        Jacquez (1996)
        """
        coords = np.asarray(coords, dtype=float)
        n = len(coords)
        if n < 2:
            return RichResult(
                payload={
                    "statistic": np.nan,
                    "p_value": np.nan,
                    "n": n,
                    "method": "Jacquez k-nearest-neighbour space-time test",
                }
            )
        x_sorted = np.sort(coords)
        if cdf is None:
            cdf_vals = stats.norm.cdf(x_sorted, loc=np.mean(coords), scale=np.std(coords, ddof=1))
        else:
            cdf_vals = np.array([cdf(xi) for xi in x_sorted])
        ecdf = np.arange(1, n + 1) / n
        ecdf_prev = np.arange(0, n) / n
