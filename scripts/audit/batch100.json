"fn": "causal_mahalanobis_match",
"params": [
"X",
"treat",
"k"
],
"title": "Mahalanobis-distance matching",
"formula": "d_M(x_i,x_j) = sqrt((x_i-x_j)^T \u03a3\u0302^{-1} (x_i-x_j))",
"ref": "Rubin (1980)"
},
{
"mod": "causmtchcm",
"fn": "causal_caliper_matching",
"params": [
"ps",
"treat",
"caliper"
],
"title": "Caliper-matching variant with logit-PS distance cap",
"formula": "Allow only matches within caliper c \u00d7 \u03c3_logit_ps",
"ref": "Cochran-Rubin (1973)"
},
{
"mod": "causovlap",
"fn": "causal_overlap_diagnostic",
"params": [
"ps",
"treat"
],
"title": "Common-support / overlap diagnostic on PS distributions",
"formula": "Report deciles of e(x) by treatment group",
"ref": "Crump et al. (2009)"
},
{
"mod": "covbal",
"fn": "covariate_balance_check",
"params": [
"A",
"H",
"weights"
],
"title": "Covariate balance check post-IPTW",
"formula": "weighted standardized mean difference",
"ref": "Austin-Stuart (2015)"
},
{
"mod": "croston",
"fn": "croston",
"params": [
"y",
"alpha"
],
"title": "Croston's method (intermittent demand)",
"formula": "separate SES on size + interval",
"ref": "Croston (1972)"
},
{
"mod": "diffsm",
"fn": "diffusion_score_matching",
"params": [
"x",
"s_theta",
"sigma"
],
"title": "Score matching for diffusion models",
"formula": "E[||s_theta(x_t,t) - grad log q(x_t|x_0)||^2]",
"ref": "Song-Ermon (2019); Ho-Jain-Abbeel (2020) DDPM"
},
{
"mod": "driftF",
"fn": "drift_forecast",
"params": [
"y",
"h"
],
"title": "Random-walk-with-drift",
"formula": "\u0177_{T+h}=y_T + h\u00b7(y_T\u2212y_1)/(T\u22121)",
"ref": "Hyndman-Athanasopoulos (2018)"
},
{
"mod": "drovw",
"fn": "dr_overlap_weighted",
"params": [
"y",
"D",
"X"
],
"title": "Overlap-weighted DR-DiD",
"formula": "weights = e(X)(1-e(X))",
"ref": "Li-Morgan-Zaslavsky (2018)"
},
{
"mod": "drpdid",
"fn": "placebo_dr_did",
"params": [
"y_pre1",
"y_pre2",
"D",
"X"
],
"title": "Placebo DR-DiD pre-period falsification",
"formula": "DR moment on pre-event period; H0: tau_placebo=0",
"ref": "Sant'Anna-Zhao (2020)"
},
{
"mod": "ebalw",
"fn": "entropy_balancing",
"params": [
"X",
"T",
"moments"
],
"title": "Entropy balancing for covariate balance (Hainmueller 2012)",
"formula": "min_w KL(w||q) s.t. sum_i w_i*X_i = mean(X_control); weights minimize entropy deviation",
"ref": "Molak Ch 9"
},
{
"mod": "ebmZD",
"fn": "zonal_ebm",
"params": [
"S",
"alpha",
"A",
"B"
],
"title": "Zonal energy balance model (Budyko-Sellers)",
"formula": "C dT/dt = (1-\u03b1(T))S/4 \u2212 A \u2212 B T",
"ref": "Budyko (1969); Sellers (1969)"
},
{
"mod": "effsiz",
"fn": "effective_sample_size",
"params": [
"n",
"deff"
],
"title": "Effective sample size n / DEFF",
"formula": "n_eff = n / DEFF",
"ref": "Kish (1965)"
},
{
"mod": "egrgrf",
"fn": "egregious_loss_forest",
"params": [
"y",
"D",
"X"
],
"title": "Loss-balanced random forest",
"formula": "split criterion balances loss across leaves",
"ref": "Athey-Tibshirani-Wager (2019) GRF"
},
{
"mod": "eqhae",
"fn": "equating_haebara",
"params": [
"y",
"b_R",
"b_F",
"a_R",
"a_F"
],
"title": "Haebara equating (item-by-item ICC matching)",
"formula": "min sum_i sum_theta (P_R_i(theta) - P_F_i(A theta + B))^2",
"ref": "Haebara (1980)"
},
{
"mod": "eqsl",
"fn": "equating_stocking_lord",
"params": [
"y",
"b_R",
"b_F",
"a_R",
"a_F"
],
"title": "Stocking-Lord equating (TCC matching)",
"formula": "min sum_theta (T_R(theta) - T_F(A theta + B))^2",
"ref": "Stocking & Lord (1983)"
},
{
"mod": "essbk",
"fn": "effective_sample_size_bulk",
"params": [
"chains"
],
"title": "Bulk effective sample size for posterior",
"formula": "ESS_bulk via rank-normalized chains",
"ref": "Vehtari et al. (2021)"
},
{
"mod": "esstl",
"fn": "effective_sample_size_tail",
"params": [
"chains"
],
"title": "Tail effective sample size (5% / 95% quantiles)",
"formula": "ESS_tail = min(ESS@5%, ESS@95%)",
"ref": "Vehtari et al. (2021)"
},
{
"mod": "esstst",
"fn": "effective_sample_size",
"params": [
"weights"
],
"title": "Effective sample size of weighted population",
"formula": "ESS = (sum w)^2 / sum w^2",
"ref": "Kish (1965)"
},
{
"mod": "esttsl",
"fn": "theta_method",
"params": [
"y",
"horizon"
],
"title": "Theta method (M3 winner)",
"formula": "weighted combination of theta lines",
"ref": "Assimakopoulos-Nikolopoulos (2000)"
},
{
"mod": "hwadd",
"fn": "holt_winters_additive",
"params": [
"y",
"period",
"alpha",
"beta",
"gamma"
],
"title": "Holt-Winters additive",
"formula": "l_t,b_t,s_t recursions with \u03b1,\u03b2,\u03b3",
"ref": "Winters (1960); Hyndman-Athanasopoulos (2018)"
},
{
"mod": "hwmul",
"fn": "holt_winters_mult",
"params": [
"y",
"period",
"alpha",
"beta",
"gamma"
],
"title": "Holt-Winters multiplicative",
"formula": "l_t,b_t,s_t recursions with multiplicative season",
"ref": "Winters (1960)"
},
{
"mod": "impala",
"fn": "impala_vtrace",
"params": [
"trajectories",
"behavior",
"target",
"clip"
],
"title": "IMPALA V-trace off-policy correction",
"formula": "v_s = V(s) + sum \u03b3^t (prod_i \u03c1_i) \u00b7 \u03b4_t V",
"ref": "Espeholt et al (2018)"
},
{
"mod": "jocros",
"fn": "joseph_croston_intermittent",
"params": [
"y",
"alpha"
],
"title": "Croston's method for intermittent / sparse demand forecasting",
"formula": "z_t = alpha*y_t + (1-alpha)*z_{t-1}  (nonzero demand size); p_t = alpha*q_t + (1-alpha)*p_{t-1} (inter-arrival); forecast = z_t / p_t",
"ref": "Joseph Ch 17, Croston intermittent demand section"
},
{
"mod": "jomint",
"fn": "joseph_mint_reconciliation",
"params": [
"y_hat",
"S",
"W"
],
"title": "MinT reconciliation: trace-minimizing weighted least-squares reconciliation",
"formula": "y_tilde = S (S^T W^{-1} S)^{-1} S^T W^{-1} y_hat;  W = covariance of base forecast errors",
"ref": "Joseph Ch 17, MinT reconciliation section"
},
{
"mod": "jonaiv",
"fn": "joseph_naive_forecast",
"params": [
"y",
"horizon"
],
"title": "Naive forecast: last observed value carried forward",
"formula": "y_hat_{T+h} = y_T  for all h >= 1",
"ref": "Joseph Ch 4, Naive Forecast baseline"
},
{
"mod": "joses",
"fn": "joseph_simple_exponential_smoothing",
"params": [
"y",
"alpha",
"horizon"
],
"title": "Simple exponential smoothing (SES) forecast",
"formula": "l_t = alpha*y_t + (1-alpha)*l_{t-1};  y_hat_{T+h} = l_T",
"ref": "Joseph Ch 4, Simple Exponential Smoothing section"
}
]